<div class="mx-auto w-full max-w-md text-center">
    <img class="mx-auto mb-10 h-14" src="/public/images/logo.png" alt="Windcraft" />

    {{#if error}}<p class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700">{{error}}</p>{{/if}}

    <!-- Step 1: Google or an email -->
    <div id="stepEmail">
        <h1 class="mb-8 text-3xl font-bold tracking-tight text-gray-900">Welcome back</h1>

        {{#if googleOn}}
        <a href="{{googleHref}}"
            class="flex w-full items-center justify-center gap-3 rounded-full border border-gray-300 bg-white py-3 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-50">
            <svg viewBox="0 0 48 48" class="size-5" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.1 5.5c4.3-4 6.8-9.9 6.8-16.9z"/><path fill="#FBBC05" d="M10.5 28.7a14.5 14.5 0 0 1 0-9.4l-7.9-6.1a24 24 0 0 0 0 21.6l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.1-5.5c-2 1.4-4.6 2.3-8.8 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
            Continue with Google
        </a>
        <div class="my-5 flex items-center gap-3 text-xs tracking-widest text-gray-400"><span class="h-px flex-1 bg-gray-200"></span>OR<span class="h-px flex-1 bg-gray-200"></span></div>
        {{/if}}

        <form id="emailForm" class="flex items-center rounded-full border border-gray-300 bg-white py-1.5 pl-5 pr-1.5 focus-within:border-gray-900">
            <input id="emailInput" type="email" placeholder="you@company.com" autocomplete="email" required
                class="min-w-0 flex-1 bg-transparent text-sm text-gray-900 placeholder-gray-400 outline-none">
            <button id="emailBtn" type="submit" aria-label="Continue" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-black text-white transition-opacity hover:opacity-85 disabled:opacity-100">
                <svg id="arrowIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                <svg id="spinIcon" class="hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".25"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            </button>
        </form>
        <p id="emailHint" class="mt-4 text-xs text-gray-500">Then enter your password.</p>
    </div>

    <!-- Step 2: password -->
    <div id="stepPassword" class="hidden">
        <h1 class="mb-2 text-3xl font-bold tracking-tight text-gray-900">Enter your password</h1>
        <p class="mb-8 text-sm text-gray-500"><span id="emailShown"></span> <button type="button" id="changeEmail" class="ml-1 font-semibold text-gray-900 hover:underline">Change</button></p>

        <form id="signinForm" onsubmit="handleSignIn(event)" class="space-y-3 text-left">
            <input type="hidden" name="email" id="emailHidden">
            <input id="passInput" type="password" name="password" placeholder="Password" autocomplete="current-password" required
                class="w-full rounded-full border border-gray-300 bg-white px-5 py-3 text-sm text-gray-900 placeholder-gray-400 outline-none focus:border-gray-900">
            <button type="submit" class="w-full rounded-full bg-black py-3 text-sm font-medium text-white transition-opacity hover:opacity-85 disabled:opacity-60">Sign in</button>
        </form>
    </div>

    <p class="mt-10 text-sm text-gray-500">
        Don't have an account?
        <a href="{{signUpHref}}" class="font-semibold text-gray-900 hover:underline">Sign up</a>
    </p>
    <p class="mt-5">
        <a href="/" class="text-sm text-gray-400 transition-colors hover:text-gray-600">&larr; Back to home</a>
    </p>
</div>

<script>
    (function () {
        var $ = function (id) { return document.getElementById(id); };
        var hint = $("emailHint"), hintText = hint.textContent;
        var busy = function (on) {
            $("emailBtn").disabled = on;
            $("arrowIcon").classList.toggle("hidden", on);
            $("spinIcon").classList.toggle("hidden", !on);
        };
        var fail = function (html) { hint.className = "mt-4 text-sm text-red-600"; hint.innerHTML = html; };
        $("emailInput").addEventListener("input", function () { hint.className = "mt-4 text-xs text-gray-500"; hint.textContent = hintText; });
        $("emailForm").addEventListener("submit", function (e) {
            e.preventDefault();
            var email = $("emailInput").value.trim();
            if (!email) return;
            busy(true);
            fetch("/users/check-email", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: email }) })
                .then(function (res) { return res.json().then(function (b) { return { status: res.status, body: b }; }); })
                .then(function (r) {
                    busy(false);
                    if (r.status !== 200) return fail(r.body.message || "Something went wrong. Try again.");
                    if (!r.body.exists) return fail('No account with that email. <a href="/auth/sign-up" class="font-semibold underline">Create one now</a>');
                    if (r.body.google) return fail("This account signs in with Google. Use the Google button above.");
                    $("emailHidden").value = email;
                    $("emailShown").textContent = email;
                    $("stepEmail").classList.add("hidden");
                    $("stepPassword").classList.remove("hidden");
                    $("passInput").focus();
                })
                .catch(function () { busy(false); fail("Server error. Try again."); });
        });
        $("changeEmail").addEventListener("click", function () {
            $("stepPassword").classList.add("hidden");
            $("stepEmail").classList.remove("hidden");
            $("emailInput").focus();
        });
    })();
</script>
