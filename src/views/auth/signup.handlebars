<div class="mx-auto w-full max-w-md text-center">
    <img class="mx-auto mb-10 h-14" src="/public/images/logo.png" alt="Windcraft" />

    <!-- Step 1: Google or an email -->
    <div id="stepEmail">
        <h1 class="mb-8 text-3xl font-bold tracking-tight text-gray-900">What is your email?</h1>

        {{#if googleOn}}
        <a href="/auth/google{{#if returnTo}}?returnTo={{returnTo}}{{/if}}"
            class="flex w-full items-center justify-center gap-3 rounded-full border border-gray-300 bg-white py-3 text-sm font-medium text-gray-800 transition-colors hover:bg-gray-50">
            <svg viewBox="0 0 48 48" class="size-5" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.1 5.5c4.3-4 6.8-9.9 6.8-16.9z"/><path fill="#FBBC05" d="M10.5 28.7a14.5 14.5 0 0 1 0-9.4l-7.9-6.1a24 24 0 0 0 0 21.6l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.1-5.5c-2 1.4-4.6 2.3-8.8 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
            Continue with Google
        </a>
        <div class="my-5 flex items-center gap-3 text-xs tracking-widest text-gray-400"><span class="h-px flex-1 bg-gray-200"></span>OR<span class="h-px flex-1 bg-gray-200"></span></div>
        {{/if}}

        <form id="emailForm" class="flex items-center rounded-full border border-gray-300 bg-white py-1.5 pl-5 pr-1.5 focus-within:border-gray-900">
            <input id="emailInput" type="email" placeholder="you@company.com" autocomplete="email" required
                class="min-w-0 flex-1 bg-transparent text-sm text-gray-900 placeholder-gray-400 outline-none">
            <button type="submit" aria-label="Continue" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-black text-white transition-opacity hover:opacity-85">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </button>
        </form>
        <p class="mt-4 text-xs text-gray-500">Next, choose a name and a password.</p>
    </div>

    <!-- Step 2: name and password -->
    <div id="stepDetails" class="hidden">
        <h1 class="mb-2 text-3xl font-bold tracking-tight text-gray-900">Create your account</h1>
        <p class="mb-8 text-sm text-gray-500"><span id="emailShown"></span> <button type="button" id="changeEmail" class="ml-1 font-semibold text-gray-900 hover:underline">Change</button></p>

        <form id="detailsForm" class="space-y-3 text-left">
            <input id="nameInput" type="text" placeholder="Full name" autocomplete="name" required
                class="w-full rounded-full border border-gray-300 bg-white px-5 py-3 text-sm text-gray-900 placeholder-gray-400 outline-none focus:border-gray-900">
            <input id="passInput" type="password" placeholder="Password (at least 6 characters)" autocomplete="new-password" minlength="6" required
                class="w-full rounded-full border border-gray-300 bg-white px-5 py-3 text-sm text-gray-900 placeholder-gray-400 outline-none focus:border-gray-900">
            <button id="createBtn" type="submit" class="w-full rounded-full bg-black py-3 text-sm font-medium text-white transition-opacity hover:opacity-85 disabled:opacity-60">Create account</button>
        </form>
    </div>

    <p class="mt-10 text-sm text-gray-500">
        Already have an account?
        <a href="/auth/sign-in" class="font-semibold text-gray-900 hover:underline">Sign in</a>
    </p>
    <p class="mt-5">
        <a href="/" class="text-sm text-gray-400 transition-colors hover:text-gray-600">&larr; Back to home</a>
    </p>
</div>

<script>
    (function () {
        var $ = function (id) { return document.getElementById(id); };
        var email = "";
        $("emailForm").addEventListener("submit", function (e) {
            e.preventDefault();
            email = $("emailInput").value.trim();
            if (!email) return;
            $("emailShown").textContent = email;
            $("stepEmail").classList.add("hidden");
            $("stepDetails").classList.remove("hidden");
            $("nameInput").focus();
        });
        $("changeEmail").addEventListener("click", function () {
            $("stepDetails").classList.add("hidden");
            $("stepEmail").classList.remove("hidden");
            $("emailInput").focus();
        });
        $("detailsForm").addEventListener("submit", function (e) {
            e.preventDefault();
            var btn = $("createBtn");
            btn.disabled = true; btn.textContent = "Creating...";
            fetch("/users", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: $("nameInput").value.trim(), email: email, password: $("passInput").value })
            }).then(function (res) { return res.json().then(function (body) { return { status: res.status, body: body }; }); })
              .then(function (r) {
                  if (r.status !== 200 && r.status !== 201) {
                      showToast(r.body.message || "Could not create the account.", "error");
                      btn.disabled = false; btn.textContent = "Create account";
                      if (r.status === 409) $("changeEmail").click();
                      return;
                  }
                  showToast("Account created!", "success");
                  setTimeout(function () { window.location.href = "/auth/sign-in"; }, 800);
              }).catch(function () {
                  showToast("Server error. Please try again.", "error");
                  btn.disabled = false; btn.textContent = "Create account";
              });
        });
    })();
</script>
