            var Lp = [], Rp = [], tail = Math.min(260, (b - a) * 0.8);
            for (k = 0; k < seg.length; k++) {
                var p0 = seg[Math.max(0, k - 1)][0], p1 = seg[Math.min(seg.length - 1, k + 1)][0], nx = -(p1[1] - p0[1]), ny = p1[0] - p0[0], ln = Math.hypot(nx, ny) || 1, dd = seg[k][1] - a, w = 2.7 * Math.pow(Math.min(1, dd / tail), 1.3) / 2;
                Lp.push([seg[k][0][0] + nx / ln * w, seg[k][0][1] + ny / ln * w]); Rp.push([seg[k][0][0] - nx / ln * w, seg[k][0][1] - ny / ln * w]);
            }
            var d = "M" + Lp[0][0].toFixed(1) + " " + Lp[0][1].toFixed(1); for (k = 1; k < Lp.length; k++) d += "L" + Lp[k][0].toFixed(1) + " " + Lp[k][1].toFixed(1);
            for (k = Rp.length - 1; k >= 0; k--) d += "L" + Rp[k][0].toFixed(1) + " " + Rp[k][1].toFixed(1);
            ribbon.setAttribute("d", d + "Z");
        };

        // the smoke: soft grey puffs that come off the line as it is drawn, swell, and drift away up and to the right
        var puff = function (x, y, delay) {
            var r0 = 4 + Math.random() * 9, c = mk("circle", { cx: x + (Math.random() - 0.5) * 22, cy: y + (Math.random() - 0.5) * 22, r: r0.toFixed(1), fill: Math.random() < 0.5 ? "#9ca3af" : "#cbd5e1" });
            dust.appendChild(c); c.style.transformBox = "fill-box"; c.style.transformOrigin = "center";
            c.animate([{ opacity: 0, transform: "translate(0,0) scale(.6)" }, { opacity: 0.34, offset: 0.25 }, { opacity: 0, transform: "translate(" + (30 + Math.random() * 110) + "px," + (-8 - Math.random() * 58) + "px) scale(" + (2 + Math.random() * 1.6) + ")" }], { duration: 1300 + Math.random() * 1200, delay: Math.max(0, delay), easing: "ease-out", fill: "backwards" });
        };
        var p0 = shape(0);
        for (i = 0; i < 70; i++) { var k0 = 41 + Math.floor(Math.random() * n), pt = p0[Math.min(k0, p0.length - 1)]; puff(pt[0], pt[1], T1 * (k0 - 41) / n - 60); }

        // the timeline of the line (1 to 3), one frame at a time
        var iconW = B.height * (150 / 152), ix = B.left + iconW / 2, iy = B.top + B.height / 2, ms = B.height / 152, mx = function (p) { return B.left + p[0] * ms; }, my = function (p) { return B.top + p[1] * ms; }, first = MARK[0][0];
        var pts0 = p0, cum0 = cumOf(pts0), tot0 = cum0[cum0.length - 1], t0 = performance.now(), flowPts = null, flowCum = null, hS = 0;
        (function frame(now) {
            var ts = now - t0;
            if (ts < T1) { draw(pts0, cum0, 0, tot0 * easeOut(ts / T1)); return requestAnimationFrame(frame); }
            if (ts < T1 + HOLD) { draw(pts0, cum0, 0, tot0); return requestAnimationFrame(frame); }
            if (ts < T1 + HOLD + T2) { var u = easeIO((ts - T1 - HOLD) / T2), ps = shape(u), cs = cumOf(ps); draw(ps, cs, 0, cs[cs.length - 1]); return requestAnimationFrame(frame); }
            if (!flowPts) {
                // the line, now a wavy line, goes on from its left end in a rippling curve up to the start of the mark's first stroke
                var base = shape(1), end = base[base.length - 1], C = [end, [end[0] - 140, end[1] - 30], [mx(first) + 120, my(first) + 100], [mx(first), my(first)]], fl = wavy(C, 80, 30, 3, "end");
                flowPts = base.concat(fl.slice(1)); flowCum = cumOf(flowPts); hS = cumOf(base)[base.length - 1] / flowCum[flowCum.length - 1];
            }
            var q = (ts - T1 - HOLD - T2) / T3, tot = flowCum[flowCum.length - 1];
            if (q < 1) { var s2 = easeIO(q), h = hS + (1 - hS) * s2, tau = Math.pow(s2, 1.35); draw(flowPts, flowCum, tau * tot, Math.max(h, tau + 0.0001) * tot); return requestAnimationFrame(frame); }
            ribbon.setAttribute("d", ""); form();
        })(t0);

        function form() {
            // the line draws the mark, stroke after stroke, along the centre lines of the real drawing; then the real logo takes over from it
            var lens = [], all = 0, k, j;
            for (k = 0; k < MARK.length; k++) { var l = 0; for (j = 1; j < MARK[k].length; j++) l += Math.hypot(MARK[k][j][0] - MARK[k][j - 1][0], MARK[k][j][1] - MARK[k][j - 1][1]); lens.push(l); all += l; }
            var at = 0, wd = Math.max(1.3, MARK_W * ms * 1.05);
            for (k = 0; k < MARK.length; k++) {
                var pts = MARK[k].map(function (p) { return [mx(p), my(p)]; }), d = "M" + pts[0][0].toFixed(2) + " " + pts[0][1].toFixed(2);
                for (j = 1; j < pts.length - 1; j++) d += "Q" + pts[j][0].toFixed(2) + " " + pts[j][1].toFixed(2) + " " + ((pts[j][0] + pts[j + 1][0]) / 2).toFixed(2) + " " + ((pts[j][1] + pts[j + 1][1]) / 2).toFixed(2);
                d += "L" + pts[pts.length - 1][0].toFixed(2) + " " + pts[pts.length - 1][1].toFixed(2);
                var sp2 = mk("path", { d: d, pathLength: "1", fill: "none", stroke: "#3f3f46", "stroke-width": wd.toFixed(2), "stroke-linecap": "round", "stroke-linejoin": "round" });
                sp2.style.strokeDasharray = "0 3"; svg.appendChild(sp2);
                sp2.animate([{ strokeDasharray: "0 3" }, { strokeDasharray: "1 3" }], { duration: Math.max(40, T4 * lens[k] / all), delay: T4 * at / all, easing: "linear", fill: "forwards" });
                at += lens[k];
            }
            setTimeout(arrive, T4 + 60);
        }

        // 5) the real logo is there, and the designs come out of it
        function arrive() {
            root.classList.remove("intro");
            svg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 450, delay: 120, fill: "forwards" }).onfinish = function () { svg.remove(); };
            sp.querySelectorAll(".spread-card").forEach(function (c) { var rc = c.getBoundingClientRect(); c.style.setProperty("--dx", (ix - (rc.left + rc.width / 2)) + "px"); c.style.setProperty("--dy", (iy - (rc.top + rc.height / 2)) + "px"); });
            sp.classList.remove("pre"); sp.classList.add("fly");
        }
    })();
</script>
