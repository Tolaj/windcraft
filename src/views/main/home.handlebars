    <!-- Actual Content -->
    <style>
    /* a narrow card has no room for the word: only "+10" shows (the card is the container, not the screen) */
    #contentGrid .component-card { container-type: inline-size; }
    /* the hero's spread of designs: a fan of cards beside the text, shown when the hero is wide enough to have the room */
    #hero { container-type: inline-size; }
    #hero .spread { display: none; position: absolute; top: 24px; right: 32px; width: min(calc(100% - 760px), 600px); height: 240px; pointer-events: none; }
    @container (min-width: 1020px) { #hero .spread { display: block; } }
    .spread-card { position: absolute; left: var(--x); top: var(--y); z-index: var(--z); width: 38%; margin: 0; overflow: hidden; border: 1px solid #e5e7eb; border-radius: 12px; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .14), 0 2px 6px rgba(0, 0, 0, .08); transform: rotate(var(--r)); transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
    #hero:hover .spread-card { transform: rotate(calc(var(--r) * 1.35)) translateY(calc(var(--z) * -1px)); }
    .sp-bar { display: flex; gap: 3px; align-items: center; height: 14px; padding-left: 7px; border-bottom: 1px solid #eee; background: #fff; }
    .sp-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .spread-card img { display: block; width: 100%; aspect-ratio: 1.5; object-fit: cover; }
    /* the opening (see the script below): the cards wait while a line winds into a spiral and flies to the logo, then fly out of the logo into the fan */
    #hero .spread.pre .spread-card { opacity: 0; }
    #hero .spread.fly .spread-card { animation: sp-fly 1.15s cubic-bezier(.2, .9, .25, 1.06) calc(var(--i) * .1s) backwards; }
    @keyframes sp-fly {
        0% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(540deg) scale(.08); }
        16% { opacity: 1; }
        100% { opacity: 1; transform: rotate(var(--r)); }
    }
    #introSvg { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 2000; overflow: visible; }
    #introSvg path { vector-effect: non-scaling-stroke; }
    @media (prefers-reduced-motion: reduce) { #hero .spread.pre .spread-card { opacity: 1; } #hero .spread.fly .spread-card { animation: none; } }
    @container (max-width: 235px) { .new-word { display: none; } }
    /* the card's picture: a real screenshot of the category's best design, in a small window (a category with no picture keeps the drawn wireframe) */
    #contentGrid .card-image:not(.no-thumb) { padding: 12px 24px 0; }
    #contentGrid .card-image:not(.no-thumb) .thumb-fallback, #contentGrid .card-image.no-thumb .thumb-win { display: none; }
    .thumb-win { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #fff; border-radius: 8px 8px 0 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .18); }
    .thumb-bar { flex: none; display: flex; align-items: center; gap: 3px; height: 12px; padding-left: 6px; border-bottom: 1px solid #eee; }
    .thumb-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .thumb-img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: center; }
</style>
<div id="contentGrid" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 p-6">

            {{#each categories}}
            <a href="/category/{{this.slug}}" data-kind="{{this.kind}}" class="component-card group block">
                <div
                    class="bg-gray-50 h-[225px] overflow-hidden border border-gray-400 rounded-xl group-hover:border-2 group-hover:border-gray-400 group-hover:shadow-xl">
                    <div
                        class="card-image h-[70%] bg-gray-100 px-10 pt-5 shadow-2xl shadow-white border border-gray-100">
                        <div class="thumb-win"><div class="thumb-bar"><i></i><i></i><i></i></div><img class="thumb-img" src="/public/images/categories/{{this.slug}}.jpg" alt="" loading="lazy" onerror="this.closest('.card-image').classList.add('no-thumb')"></div>
                        <div class="thumb-fallback">{{> category-thumbnail slug=this.slug}}</div>
                    </div>
                    <div class="flex items-center h-[30%] justify-between bg-white p-4">
                        <div class="min-w-0 flex-1">
                            <h4 class="mb-1 truncate font-semibold text-primary text-sm group-hover:text-primary transition" title="{{this.name}}">{{this.name}}</h4>
                            <p class="flex items-center gap-2 whitespace-nowrap text-sm text-gray-500">{{this.count}} components
                                {{#if this.hasNew}}<span class="shrink-0 rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-primary">+{{this.newCount}}<span class="new-word"> NEW</span></span>{{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </a>
            {{/each}}

        </div>
    </div>

    <script>
        document.getElementById("skeletonGrid").classList.add("hidden");
        document.getElementById("contentGrid").classList.remove("hidden");
        (function () {
            var tabs = document.getElementById("kindTabs");
            if (!tabs) return;
            var show = function (kind) {
                [].forEach.call(tabs.querySelectorAll(".kind-tab"), function (t) { t.setAttribute("aria-selected", String(t.dataset.kind === kind)); });
                [].forEach.call(document.querySelectorAll(".component-card[data-kind]"), function (c) { c.classList.toggle("kind-hidden", Boolean(kind) && c.dataset.kind !== kind); });
                try { sessionStorage.setItem("wc:galleryKind", kind); } catch (e) {}
            };
            tabs.addEventListener("click", function (e) { var b = e.target.closest(".kind-tab"); if (b) show(b.dataset.kind); });
            var saved = ""; try { saved = sessionStorage.getItem("wc:galleryKind") || ""; } catch (e) {}
            if (saved) show(saved);
        })();
    </script>
</main>



{{!-- Modals --}}

{{> component-playground/index}}

<script>
    // The hero's opening, once per visit (the page head decides: it hides the mark of the logo with html.intro, the wordmark stays):
    //  1. a thick black ribbon sweeps in from the right edge and circles into a vortex over the right of the hero; the designs come out of the vortex and settle into the fan;
    //  2. a second ribbon sweeps in low from the right, to the left, and curls up into the logo: it draws the exact mark (the centre lines of the real drawing), big;
    //  3. the mark flies up into its place in the header and the real logo takes over.
