{{> component-playground/index}}

<script>
    // The hero's opening: the tornado line is drawn as one path (a line that sweeps in from the left, then coils down into a spiral), then the designs fly out of it.
    (function () {
        var sp = document.querySelector("#hero .spread"), path = document.getElementById("tornadoPath");
        if (!sp || !path) return;
        var d = "", pts = [], i, t;
        // the incoming line: a swoop from outside on the left to the top of the spiral
        var P = [[-70, 205], [70, 110], [190, 6], [300, 38]];
        for (i = 0; i <= 40; i++) { t = i / 40; var u = 1 - t; pts.push([u * u * u * P[0][0] + 3 * u * u * t * P[1][0] + 3 * u * t * t * P[2][0] + t * t * t * P[3][0], u * u * u * P[0][1] + 3 * u * u * t * P[1][1] + 3 * u * t * t * P[2][1] + t * t * t * P[3][1]]); }
        // the spiral: loops that narrow as they go down (a tornado), each one a flat ellipse
        var turns = 6, n = 260;
        for (i = 1; i <= n; i++) { t = i / n; var a = t * turns * 2 * Math.PI, r = 84 * Math.pow(1 - t, 0.85) + 5; pts.push([300 + r * Math.cos(a) + 14 * Math.sin(t * 5), 40 + t * 176 + r * 0.3 * Math.sin(a)]); }
        for (i = 0; i < pts.length; i++) d += (i ? "L" : "M") + pts[i][0].toFixed(1) + " " + pts[i][1].toFixed(1);
        path.setAttribute("d", d);
        var key = "wc:hero-played", seen = false;
        try { seen = sessionStorage.getItem(key) === "1"; sessionStorage.setItem(key, "1"); } catch (e) { /* no storage: it plays */ }
        if (seen || getComputedStyle(sp).display === "none") return;
        sp.classList.add("play");
    })();
</script>
