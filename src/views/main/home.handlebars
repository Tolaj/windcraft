            mist.forEach(function (m) { m.el.style.strokeDashoffset = String(-(m.off0 + ts * 0.5 * m.speed)); m.el.setAttribute("opacity", (menv * m.base * (0.8 + 0.2 * Math.sin(ts / 160 + m.ph))).toFixed(3)); });
            // the designs tumble about in the vortex, each its own way (in 3D: they swing round it, turn over, nearer and further), ghostly and blurred; then they settle into the fan
            if (ts >= T_CARDS && !fired.done) {
                if (!fired.cards) { fired.cards = 1; sp.classList.remove("pre"); }
                var sc0 = easeIO(clamp((ts - T_CONV) / D_CONV)), kk = 1 - sc0;
                cinfo.forEach(function (ci, i) {
                    var te = ts - T_CARDS - i * 80;
                    if (te < 0) { ci.c.style.opacity = "0"; return; }
                    var th = ci.th0 + te / 1000 * ci.w * (1 - 0.55 * sc0), a = ci.ra * (0.3 + 0.7 * kk), b = ci.rb * (0.3 + 0.7 * kk);
                    var ex = a * Math.cos(th), ey = -b * Math.sin(th), ox = VC[0] + ex * cT - ey * sT, oy = VC[1] + ex * sT + ey * cT, z = ci.dz * Math.sin(th) * kk;
                    var tx = lerp(ox - ci.fx, 0, sc0), ty = lerp(oy - ci.fy, 0, sc0);
                    var rx = kk * ci.ax * Math.sin(te / 1000 * ci.wx + ci.p1), ry = kk * (ci.ay * Math.sin(te / 1000 * ci.wy + ci.p2) + 26 * Math.cos(th)), rz = ci.r + kk * ci.az * Math.sin(te / 1000 * ci.wz + ci.p3);
                    ci.c.style.transform = "translate3d(" + tx.toFixed(1) + "px," + ty.toFixed(1) + "px," + z.toFixed(1) + "px) rotateX(" + rx.toFixed(1) + "deg) rotateY(" + ry.toFixed(1) + "deg) rotateZ(" + rz.toFixed(1) + "deg) scale(" + lerp(0.82, 1, sc0).toFixed(3) + ")";
                    ci.c.style.opacity = (clamp(te / 220) * lerp(0.78, 1, sc0)).toFixed(3);
                    ci.c.style.filter = "blur(" + lerp(3.6, 0, clamp((sc0 - 0.2) / 0.8)).toFixed(2) + "px)";
                    ci.c.style.zIndex = String(100 + Math.round(z));
                });
                if (sc0 >= 1) { fired.done = 1; cinfo.forEach(function (ci) { ci.c.style.transform = ""; ci.c.style.filter = ""; ci.c.style.opacity = ""; ci.c.style.zIndex = ""; ci.c.style.transition = ""; }); }
            }
            // the mark is uncovered along the spiral, from its right end to its left end, where the ribbon has arrived
            var pr = clamp((ts - T_DRAW) / D_DRAW);
            brush.style.strokeDasharray = easeIO(pr) + " 3"; brush.style.opacity = pr > 0 ? "1" : "0";   // (a zero-length dash with round ends is a dot: it would uncover a bit of the logo before its time) rest.setAttribute("opacity", clamp((pr - 0.88) / 0.12).toFixed(3));
            if (ts >= T_DRAW + D_DRAW + 80) { arrive(); return; }
