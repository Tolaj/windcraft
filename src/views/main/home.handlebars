            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
