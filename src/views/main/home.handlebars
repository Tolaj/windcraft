    <!-- Actual Content -->
    <style>
    /* a narrow card has no room for the word: only "+10" shows (the card is the container, not the screen) */
    #contentGrid .component-card { container-type: inline-size; }
    /* the hero's spread of designs: a fan of cards beside the text, shown when the hero is wide enough to have the room */
    #hero { container-type: inline-size; }
    #hero .spread { display: none; position: absolute; top: 24px; right: 32px; width: min(calc(100% - 760px), 600px); height: 240px; pointer-events: none; }
    @container (min-width: 1020px) { #hero .spread { display: block; } }
    .spread-card { position: absolute; left: var(--x); top: var(--y); z-index: var(--z); width: 38%; margin: 0; overflow: hidden; border: 1px solid #e5e7eb; border-radius: 12px; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .14), 0 2px 6px rgba(0, 0, 0, .08); transform: rotate(var(--r)); transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
    #hero:hover .spread-card { transform: rotate(calc(var(--r) * 1.35)) translateY(calc(var(--z) * -1px)); }
    .sp-bar { display: flex; gap: 3px; align-items: center; height: 14px; padding-left: 7px; border-bottom: 1px solid #eee; background: #fff; }
    .sp-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .spread-card img { display: block; width: 100%; aspect-ratio: 1.5; object-fit: cover; }
    /* the opening (see the script below): the designs wait, then tumble about in the vortex (3D, ghostly and blurred) and settle into the fan */
    #hero .spread { perspective: 1100px; perspective-origin: 50% 55%; }
    #hero .spread.pre .spread-card { opacity: 0; }
    #introSvg { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 2000; overflow: visible; }
    #introSvg path { vector-effect: non-scaling-stroke; }
    @media (prefers-reduced-motion: reduce) { #hero .spread.pre .spread-card { opacity: 1; } }
    @container (max-width: 235px) { .new-word { display: none; } }
    /* the card's picture: a real screenshot of the category's best design, in a small window (a category with no picture keeps the drawn wireframe) */
    #contentGrid .card-image:not(.no-thumb) { padding: 12px 24px 0; }
    #contentGrid .card-image:not(.no-thumb) .thumb-fallback, #contentGrid .card-image.no-thumb .thumb-win { display: none; }
    .thumb-win { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #fff; border-radius: 8px 8px 0 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .18); }
    .thumb-bar { flex: none; display: flex; align-items: center; gap: 3px; height: 12px; padding-left: 6px; border-bottom: 1px solid #eee; }
    .thumb-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .thumb-img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: center; }
</style>
<div id="contentGrid" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 p-6">

            {{#each categories}}
            <a href="/category/{{this.slug}}" data-kind="{{this.kind}}" class="component-card group block">
                <div
                    class="bg-gray-50 h-[225px] overflow-hidden border border-gray-400 rounded-xl group-hover:border-2 group-hover:border-gray-400 group-hover:shadow-xl">
                    <div
                        class="card-image h-[70%] bg-gray-100 px-10 pt-5 shadow-2xl shadow-white border border-gray-100">
                        <div class="thumb-win"><div class="thumb-bar"><i></i><i></i><i></i></div><img class="thumb-img" src="/public/images/categories/{{this.slug}}.jpg" alt="" loading="lazy" onerror="this.closest('.card-image').classList.add('no-thumb')"></div>
                        <div class="thumb-fallback">{{> category-thumbnail slug=this.slug}}</div>
                    </div>
                    <div class="flex items-center h-[30%] justify-between bg-white p-4">
                        <div class="min-w-0 flex-1">
                            <h4 class="mb-1 truncate font-semibold text-primary text-sm group-hover:text-primary transition" title="{{this.name}}">{{this.name}}</h4>
                            <p class="flex items-center gap-2 whitespace-nowrap text-sm text-gray-500">{{this.count}} components
                                {{#if this.hasNew}}<span class="shrink-0 rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-primary">+{{this.newCount}}<span class="new-word"> NEW</span></span>{{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </a>
            {{/each}}

        </div>
    </div>

    <script>
        document.getElementById("skeletonGrid").classList.add("hidden");
        document.getElementById("contentGrid").classList.remove("hidden");
        (function () {
            var tabs = document.getElementById("kindTabs");
            if (!tabs) return;
            var show = function (kind) {
                [].forEach.call(tabs.querySelectorAll(".kind-tab"), function (t) { t.setAttribute("aria-selected", String(t.dataset.kind === kind)); });
                [].forEach.call(document.querySelectorAll(".component-card[data-kind]"), function (c) { c.classList.toggle("kind-hidden", Boolean(kind) && c.dataset.kind !== kind); });
                try { sessionStorage.setItem("wc:galleryKind", kind); } catch (e) {}
            };
            tabs.addEventListener("click", function (e) { var b = e.target.closest(".kind-tab"); if (b) show(b.dataset.kind); });
            var saved = ""; try { saved = sessionStorage.getItem("wc:galleryKind") || ""; } catch (e) {}
            if (saved) show(saved);
        })();
    </script>
</main>



{{!-- Modals --}}

{{> component-playground/index}}

<script>
    // The hero's opening, once per visit (the page head decides: it hides the mark of the logo with html.intro, the wordmark stays):
    //  1. a thick black ribbon sweeps in from the right edge and circles into a vortex over the right of the hero; the designs come out of the vortex and settle into the fan;
    //  2. the spin ends and the ribbon leaves the vortex, flying (rippling) across to the top left corner, where it draws the exact mark of the logo (the centre lines of the real drawing) in place;
    //  3. the real logo takes over from the drawing.
    (function () {
        var root = document.documentElement, hero = document.getElementById("hero"), sp = document.querySelector("#hero .spread"), brand = document.querySelector("[data-brand]");
        var done = function () { root.classList.remove("intro"); if (sp) sp.classList.remove("pre"); };
        if (!root.classList.contains("intro")) return;
        try { sessionStorage.setItem("wc:hero-played", "1"); } catch (e) { /* ignore */ }
        if (!hero || !sp || !brand || getComputedStyle(sp).display === "none" || !sp.animate) return done();
        sp.classList.add("pre");

        var NS = "http://www.w3.org/2000/svg", mk = function (n, a) { var e = document.createElementNS(NS, n); for (var k in a) e.setAttribute(k, a[k]); return e; };
        var bez = function (P, t) { var u = 1 - t; return [u * u * u * P[0][0] + 3 * u * u * t * P[1][0] + 3 * u * t * t * P[2][0] + t * t * t * P[3][0], u * u * u * P[0][1] + 3 * u * u * t * P[1][1] + 3 * u * t * t * P[2][1] + t * t * t * P[3][1]]; };
        var lerp = function (a, b, u) { return a + (b - a) * u; }, clamp = function (x) { return Math.min(1, Math.max(0, x)); };
        var easeIO = function (x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; }, easeOut = function (x) { return 1 - Math.pow(1 - x, 2.4); };
        // a curve with ripples: the points of a bezier moved sideways by a sine; zero at both ends ("mid") or dying away towards the end ("end")
        var wavy = function (P, count, amp, waves, mode) {
            var out = [], k, t, q, q1, q2, nx, ny, len, off;
            for (k = 0; k <= count; k++) {
                t = k / count; q = bez(P, t); q2 = bez(P, Math.min(1, t + 0.01)); q1 = bez(P, Math.max(0, t - 0.01));
                nx = -(q2[1] - q1[1]); ny = q2[0] - q1[0]; len = Math.hypot(nx, ny) || 1;
                off = amp * Math.sin(t * waves * 2 * Math.PI) * (mode === "end" ? (1 - t) : Math.sin(Math.PI * t));
                out.push([q[0] + nx / len * off, q[1] + ny / len * off]);
            }
            return out;
        };
        var cumOf = function (pts) { var c = [0], k; for (k = 1; k < pts.length; k++) c.push(c[k - 1] + Math.hypot(pts[k][0] - pts[k - 1][0], pts[k][1] - pts[k - 1][1])); return c; };
        var R = sp.getBoundingClientRect(), H = hero.getBoundingClientRect(), B = brand.getBoundingClientRect(), W = window.innerWidth;
        var MARK_W = 5.2;   // (the thickness of the logo's strokes, in the 152 px high drawing)

        var svg = mk("svg", { id: "introSvg", "aria-hidden": "true" }), defs = mk("defs", {});
        var fb = mk("filter", { id: "introBlur", x: "-20%", y: "-60%", width: "140%", height: "220%" }); fb.appendChild(mk("feGaussianBlur", { stdDeviation: "2.2" })); defs.appendChild(fb);
        var fm = mk("filter", { id: "introMist", x: "-30%", y: "-80%", width: "160%", height: "260%" }); fm.appendChild(mk("feGaussianBlur", { stdDeviation: "7" })); defs.appendChild(fm);
        svg.appendChild(defs); document.body.appendChild(svg);

        // a ribbon: the part of a polyline between two lengths, as a black shape that is thick in the middle and thins out to nothing at both ends; the tail also fades
        var FADE = 7;   // the tail fades in this many steps; the rest of the ribbon is one black shape
        var makeRibbon = function () { var g = mk("g", {}), parts = [], k; for (k = 0; k <= FADE; k++) { var q = mk("path", { fill: "#16161a" }); g.appendChild(q); parts.push(q); } svg.appendChild(g); return { g: g, parts: parts }; };
        var drawRibbon = function (rb, pts, cum, a, b, wmax, wfun) {
            if (b - a < 2) { rb.parts.forEach(function (q) { q.setAttribute("d", ""); }); return; }
            var at = function (Ls) { var lo = 0, hi = cum.length - 1; while (hi - lo > 1) { var m = (lo + hi) >> 1; if (cum[m] <= Ls) lo = m; else hi = m; } var f = (Ls - cum[lo]) / ((cum[hi] - cum[lo]) || 1); return [lerp(pts[lo][0], pts[hi][0], f), lerp(pts[lo][1], pts[hi][1], f)]; };
            var widthAt = function (u) { return wmax * Math.pow(Math.min(1, u / 0.5), 1.1) * (u > 0.95 ? 1 - (u - 0.95) / 0.05 * 0.5 : 1); };
            var span = b - a, k, j, FZ = 0.4;
            var shape = function (u0, u1, over) {
                var A = a + span * u0, Bn = Math.min(b, a + span * u1 + over), seg = [[at(A), A]];
                for (k = 0; k < cum.length; k++) if (cum[k] > A && cum[k] < Bn) seg.push([pts[k], cum[k]]); seg.push([at(Bn), Bn]);
                var Lp = [], Rp = [];
                for (k = 0; k < seg.length; k++) {
                    var p0 = seg[Math.max(0, k - 1)][0], p1 = seg[Math.min(seg.length - 1, k + 1)][0], nx = -(p1[1] - p0[1]), ny = p1[0] - p0[0], ln = Math.hypot(nx, ny) || 1, w = widthAt((seg[k][1] - a) / span) * (wfun ? wfun(seg[k][1]) : 1) / 2;
                    Lp.push([seg[k][0][0] + nx / ln * w, seg[k][0][1] + ny / ln * w]); Rp.push([seg[k][0][0] - nx / ln * w, seg[k][0][1] - ny / ln * w]);
                }
                var d = "M" + Lp[0][0].toFixed(1) + " " + Lp[0][1].toFixed(1); for (k = 1; k < Lp.length; k++) d += "L" + Lp[k][0].toFixed(1) + " " + Lp[k][1].toFixed(1);
                for (k = Rp.length - 1; k >= 0; k--) d += "L" + Rp[k][0].toFixed(1) + " " + Rp[k][1].toFixed(1);
                return d + "Z";
            };
            for (j = 0; j < FADE; j++) { rb.parts[j].setAttribute("d", shape(FZ * j / FADE, FZ * (j + 1) / FADE, span * 0.004)); rb.parts[j].setAttribute("fill-opacity", ((j + 0.7) / (FADE + 0.4)).toFixed(2)); }
            rb.parts[FADE].setAttribute("d", shape(FZ, 1, 0)); rb.parts[FADE].setAttribute("fill-opacity", "1");
        };

        // ---- the first ribbon: in from the right edge, then round and round (an ellipse that tightens a little) over the middle of the fan
        var VC = [R.left + R.width * 0.5, R.top + R.height * 0.55], T = -0.22, cT = Math.cos(T), sT = Math.sin(T), TURNS = 2 + 55 / 360;   // the spin ends on the upper right of the ellipse, where its tangent points up and to the left: the way to the logo
        var orbitAt = function (th) { var k = 1 - 0.16 * th / (2 * Math.PI), a = 270 * k * Math.cos(th), b = -78 * k * Math.sin(th); return [VC[0] + a * cT - b * sT, VC[1] + a * sT + b * cT]; };
        var o0 = orbitAt(0), pts1 = wavy([[W + 70, VC[1] - 170], [W - 140, VC[1] - 160], [o0[0] + 160, o0[1] - 70], o0], 34, 16, 1.4, "mid"), k1;
        for (k1 = 1; k1 <= 220; k1++) pts1.push(orbitAt(k1 / 220 * TURNS * 2 * Math.PI));
        var orbitEnd = pts1.length - 1, E = pts1[orbitEnd], E2 = pts1[orbitEnd - 3], tx = E[0] - E2[0], ty = E[1] - E2[1], tl = Math.hypot(tx, ty) || 1;
        // where the mark is, in the header (the left fifth of the logo image, as high as the image), and the strokes of it: the first one starts where the ribbon arrives
        var ix = B.left + (B.height * (150 / 152)) / 2, iy = B.top + B.height / 2, ms = B.height / 152, bx = function (p) { return B.left + p[0] * ms; }, by = function (p) { return B.top + p[1] * ms; };
        var f0 = [bx([142, 100]), by([142, 100])];   // the logo is a spiral: it starts on the right (the small end) and winds out to the left (the big end): the ribbon arrives at its start
        // the way out: the ribbon leaves the vortex along the way it was going and ripples across to the top left corner
        var exit = wavy([E, [E[0] + tx / tl * 320, E[1] + ty / tl * 320], [f0[0] + 260, f0[1] + 110], f0], 90, 34, 3.2, "mid");
        for (k1 = 1; k1 < exit.length; k1++) pts1.push(exit[k1]);
        var cum1 = cumOf(pts1), tot1 = cum1[cum1.length - 1], lenOrbit = cum1[orbitEnd], rb1 = makeRibbon();

        // the swirl: pale streaks that run round the same ellipse, blurred, while the designs come out
        var rings = [], k;
        for (k = 0; k < 4; k++) {
            var el = mk("ellipse", { cx: VC[0], cy: VC[1], rx: 215 + k * 34, ry: 52 + k * 15, fill: "none", stroke: k % 2 ? "#9ca3af" : "#d1d5db", "stroke-width": 2.2 + k * 0.8, "stroke-linecap": "round", filter: "url(#introBlur)", opacity: 0, transform: "rotate(" + (T * 180 / Math.PI) + " " + VC[0] + " " + VC[1] + ")" });
            el.style.strokeDasharray = (250 + k * 60) + " " + (170 + k * 40); svg.insertBefore(el, svg.children[1]); rings.push(el);
        }

        // the mist: wide white streaks that run round the vortex over the designs while they come out of it (they are what makes the designs look ghostly at first)
        var mist = [], gMist = mk("g", {}); svg.appendChild(gMist);
        for (k = 0; k < 8; k++) {
            var rx0 = 150 + Math.random() * 190, ry0 = rx0 * (0.2 + Math.random() * 0.14), len0 = Math.PI * (3 * (rx0 + ry0) - Math.sqrt((3 * rx0 + ry0) * (rx0 + 3 * ry0))), fr = 0.25 + Math.random() * 0.3;
            var me = mk("ellipse", { cx: VC[0] + (Math.random() - 0.5) * 50, cy: VC[1] + (Math.random() - 0.4) * 30, rx: rx0, ry: ry0, fill: "none", stroke: "#fff", "stroke-width": 22 + Math.random() * 36, "stroke-linecap": "round", filter: "url(#introMist)", opacity: 0, transform: "rotate(" + ((T * 180 / Math.PI) + (Math.random() - 0.5) * 14).toFixed(1) + " " + VC[0] + " " + VC[1] + ")" });
            me.style.strokeDasharray = (len0 * fr).toFixed(0) + " " + (len0 * (1 - fr)).toFixed(0); gMist.appendChild(me);
            mist.push({ el: me, speed: (0.5 + Math.random()) * (Math.random() < 0.8 ? 1 : -1), base: 0.55 + Math.random() * 0.4, off0: Math.random() * len0, ph: Math.random() * 6 });
        }

        // how thick the ribbon is along its way: full in the vortex, then thinning out as it flies off to the logo, until at the logo it is as thick as the strokes of the mark are
        var wEnd = Math.max(1.3, MARK_W * ms * 1.05) / 8, ribbonW = function (L) { if (L <= lenOrbit) return 1; var q = clamp((L - lenOrbit) / (tot1 - lenOrbit)); return lerp(1, wEnd, Math.pow(q, 0.55)); };

        // ---- the mark: the real logo, uncovered along a spiral that starts at its right end and winds out to its left end (a brush that follows the way the logo was drawn: loops that get bigger as they go left)
        var coil = [], kc, NC = 340, LOOPS = 7, tilt = 20 * Math.PI / 180;
        for (kc = 0; kc <= NC; kc++) {
            var tt = kc / NC, a = tt * LOOPS * 2 * Math.PI, ryy = 12 + 54 * Math.pow(tt, 0.9), rxx = ryy * 0.3, cxx = 142 - 128 * tt, cyy = 100 - 30 * tt, ex = rxx * Math.cos(a), ey = ryy * Math.sin(a);
            coil.push([bx([cxx + ex * Math.cos(tilt) + ey * Math.sin(tilt), cyy - ex * Math.sin(tilt) + ey * Math.cos(tilt)]), by([cxx + ex * Math.cos(tilt) + ey * Math.sin(tilt), cyy - ex * Math.sin(tilt) + ey * Math.cos(tilt)])]);
        }
        var coilD = ""; coil.forEach(function (q, i) { coilD += (i ? "L" : "M") + q[0].toFixed(1) + " " + q[1].toFixed(1); });
        var iconWpx = B.height * (150 / 152), mask = mk("mask", { id: "introMark", maskUnits: "userSpaceOnUse", x: B.left - 8, y: B.top - 8, width: iconWpx + 16, height: B.height + 16 });
        var brush = mk("path", { d: coilD, pathLength: "1", fill: "none", stroke: "#fff", "stroke-width": (B.height * 0.2).toFixed(1), "stroke-linecap": "round", "stroke-linejoin": "round" }); brush.style.strokeDasharray = "0 3";
        var rest = mk("rect", { x: B.left - 8, y: B.top - 8, width: iconWpx + 16, height: B.height + 16, fill: "#fff", opacity: 0 });   // (at the end, whatever the brush has not reached is uncovered too)
        mask.appendChild(brush); mask.appendChild(rest); defs.appendChild(mask);
        svg.appendChild(mk("image", { href: "/public/images/logo.png", x: B.left, y: B.top, width: B.width, height: B.height, mask: "url(#introMark)" }));

        // ---- times (ms from the start)
        var T_CARDS = 600, T_CONV = 2000, D_CONV = 1000, T_IN = 1750, T_OUT = 1250, T_DRAW = T_IN + T_OUT, D_DRAW = 950;
        var cinfo = [].slice.call(sp.querySelectorAll(".spread-card")).map(function (c, i, all2) {
            var rc = c.getBoundingClientRect(), rr = function (a, b) { return a + Math.random() * (b - a); };
            c.style.transition = "none"; c.style.opacity = "0";
            return { c: c, fx: rc.left + rc.width / 2, fy: rc.top + rc.height / 2, r: parseFloat(getComputedStyle(c).getPropertyValue("--r")) || 0, th0: i / all2.length * 2 * Math.PI + rr(0, 0.8), w: rr(1.7, 3.4), ra: rr(45, 130), rb: rr(14, 46), dz: rr(80, 160), ax: rr(10, 26), ay: rr(18, 38), az: rr(8, 24), wx: rr(1.6, 3.2), wy: rr(1.4, 3), wz: rr(1.6, 3.2), p1: rr(0, 6), p2: rr(0, 6), p3: rr(0, 6) };
        });
        var t0 = performance.now(), fired = {};
        (function frame() {
            var ts = performance.now() - t0;
            // the ribbon: its head runs in and round the vortex, then out of it and across to the mark; its tail follows a long way behind and then catches up
            var head = ts < T_IN ? easeOut(clamp(ts / T_IN)) * lenOrbit : lenOrbit + easeIO(clamp((ts - T_IN) / T_OUT)) * (tot1 - lenOrbit);
            var LAG = 1500, tail = ts < T_DRAW ? Math.max(0, head - LAG) : lerp(Math.max(0, tot1 - LAG), tot1, easeIO(clamp((ts - T_DRAW) / 600)));
            drawRibbon(rb1, pts1, cum1, tail, Math.max(head, tail + 0.001), 8, ribbonW);
            if (ts > T_DRAW + 650) rb1.parts.forEach(function (qq) { qq.setAttribute("d", ""); });
            // the swirl streaks run and fade
            rings.forEach(function (el, i) { var q = clamp((ts - (T_CARDS - 150 + i * 60)) / 2300); el.setAttribute("opacity", (Math.sin(Math.PI * q) * 0.5).toFixed(3)); el.style.strokeDashoffset = String(-ts * (0.35 + i * 0.12) * (i % 2 ? -1 : 1)); });
            // the mist builds up round the vortex, then thins away once the designs are out
