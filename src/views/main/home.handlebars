<!-- Main Content Area -->
<main class="flex-1">
    <!-- Hero -->
    <section id="hero" class="relative mx-6 mt-6 overflow-hidden rounded-xl border border-gray-200 bg-white p-6 md:p-8">
        <!-- a spread of designs from the gallery, in the room beside the text (only where there is room: the section is wide) -->
        <div class="spread" aria-hidden="true">
            <figure class="spread-card" style="--x:0%;--xn:0;--y:48px;--yn:48;--i:0;--r:-11deg;--z:1"><div class="sp-bar"><i></i><i></i><i></i></div><img src="/public/images/categories/layout-basic.jpg" alt="" loading="lazy" onerror="this.closest('figure').remove()"></figure>
            <figure class="spread-card" style="--x:15%;--xn:15;--y:22px;--yn:22;--i:1;--r:-5deg;--z:2"><div class="sp-bar"><i></i><i></i><i></i></div><img src="/public/images/categories/marketing-pricing.jpg" alt="" loading="lazy" onerror="this.closest('figure').remove()"></figure>
            <figure class="spread-card" style="--x:31%;--xn:31;--y:2px;--yn:2;--i:2;--r:0deg;--z:5"><div class="sp-bar"><i></i><i></i><i></i></div><img src="/public/images/categories/marketing-hero.jpg" alt="" loading="lazy" onerror="this.closest('figure').remove()"></figure>
            <figure class="spread-card" style="--x:47%;--xn:47;--y:22px;--yn:22;--i:3;--r:5deg;--z:4"><div class="sp-bar"><i></i><i></i><i></i></div><img src="/public/images/categories/ecommerce-products.jpg" alt="" loading="lazy" onerror="this.closest('figure').remove()"></figure>
            <figure class="spread-card" style="--x:62%;--xn:62;--y:48px;--yn:48;--i:4;--r:11deg;--z:3"><div class="sp-bar"><i></i><i></i><i></i></div><img src="/public/images/categories/apps-charts.jpg" alt="" loading="lazy" onerror="this.closest('figure').remove()"></figure>
        </div>
        <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Design in Tailwind, keep it as code</p>
        <h1 class="mt-2 max-w-2xl text-3xl font-semibold tracking-[-0.04em] text-gray-900 md:text-4xl">The component library your AI tools can actually use.</h1>
        <p class="mt-3 max-w-2xl text-[15px] text-gray-600">Bring a design in from Figma, or write and edit it here. Keep everything in projects, export it to React, Vue and Svelte, and let coding agents read and write it over MCP instead of guessing.</p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            {{#if user}}
            <a href="/projects" class="inline-flex h-10 items-center rounded-md bg-black px-5 text-sm font-medium text-white hover:bg-neutral-800">Open your projects</a>
            <button type="button" command="show-modal" commandfor="dialog" class="inline-flex h-10 items-center rounded-md border border-gray-300 px-5 text-sm font-medium text-gray-800 hover:bg-gray-50">Open editor</button>
            {{else}}
            <a href="/auth/sign-up" class="inline-flex h-10 items-center rounded-md bg-black px-5 text-sm font-medium text-white hover:bg-neutral-800">Get started</a>
            <a href="/documentation" class="inline-flex h-10 items-center rounded-md border border-gray-300 px-5 text-sm font-medium text-gray-800 hover:bg-gray-50">Documentation</a>
            {{/if}}
        </div>
        <ul class="mt-6 grid gap-3 text-sm text-gray-700 sm:grid-cols-2 lg:grid-cols-4">
            <li class="rounded-lg border border-gray-200 p-3"><a href="https://www.figma.com/community/plugin/1697363010304569719" target="_blank" rel="noopener" class="font-medium text-gray-900 underline">Figma to code</a><br>Send a Figma design and get editable Tailwind code, not a picture.</li>
            <li class="rounded-lg border border-gray-200 p-3"><span class="font-medium text-gray-900">Projects and a theme</span><br>Every design lives in a project that shares one look.</li>
            <li class="rounded-lg border border-gray-200 p-3"><span class="font-medium text-gray-900">Export anywhere</span><br>HTML, React, Vue or Svelte in one click.</li>
            <li class="rounded-lg border border-gray-200 p-3"><span class="font-medium text-gray-900">MCP for coding agents</span><br>Claude Code and Cursor read and write your projects.</li>
        </ul>
    </section>

    <h2 id="gallery" class="mx-6 mt-10 text-lg font-semibold tracking-tight text-gray-900">Gallery</h2>
    {{#if pageCount}}{{#if componentCount}}
    <div id="kindTabs" class="mx-6 mt-3 flex gap-1.5" role="tablist" aria-label="Show">
        <button type="button" role="tab" data-kind="" aria-selected="true" class="kind-tab rounded-full border px-3.5 py-1 text-sm font-medium">All <span class="opacity-60">{{totalComponents}}</span></button>
        <button type="button" role="tab" data-kind="page" aria-selected="false" class="kind-tab rounded-full border px-3.5 py-1 text-sm font-medium">Pages <span class="opacity-60">{{pageCount}}</span></button>
        <button type="button" role="tab" data-kind="component" aria-selected="false" class="kind-tab rounded-full border px-3.5 py-1 text-sm font-medium">Components <span class="opacity-60">{{componentCount}}</span></button>
    </div>
    <style>
        .kind-tab { background: #fff; border-color: #d1d5db; color: #374151; }
        .kind-tab:hover { border-color: #9ca3af; }
        .kind-tab[aria-selected="true"] { background: #111827; border-color: #111827; color: #fff; }
        .component-card.kind-hidden { display: none !important; }
    </style>
    {{/if}}{{/if}}
    <!-- Skeleton Loader -->
    <div id="skeletonGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 p-6">
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl h-[225px] overflow-hidden">
            <div class="h-[70%] p-5"><div class="skeleton h-3 w-16 mb-4"></div><div class="skeleton h-3 w-full mb-3"></div><div class="skeleton h-3 w-3/4 mb-3"></div><div class="skeleton h-6 w-20 mb-3"></div><div class="skeleton h-2 w-1/2"></div></div>
            <div class="h-[30%] p-4 border-t border-gray-100"><div class="skeleton h-4 w-32 mb-2"></div><div class="skeleton h-3 w-24"></div></div>
        </div>
    </div>

    <!-- Actual Content -->
    <style>
    /* a narrow card has no room for the word: only "+10" shows (the card is the container, not the screen) */
    #contentGrid .component-card { container-type: inline-size; }
    /* the hero's spread of designs: a fan of cards beside the text, shown when the hero is wide enough to have the room */
    #hero { container-type: inline-size; }
    #hero .spread { display: none; position: absolute; top: 24px; right: 32px; width: min(calc(100% - 760px), 600px); height: 240px; pointer-events: none; }
    @container (min-width: 1020px) { #hero .spread { display: block; } }
    .spread-card { position: absolute; left: var(--x); top: var(--y); z-index: var(--z); width: 38%; margin: 0; overflow: hidden; border: 1px solid #e5e7eb; border-radius: 12px; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, .14), 0 2px 6px rgba(0, 0, 0, .08); transform: rotate(var(--r)); transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
    #hero:hover .spread-card { transform: rotate(calc(var(--r) * 1.35)) translateY(calc(var(--z) * -1px)); }
    .sp-bar { display: flex; gap: 3px; align-items: center; height: 14px; padding-left: 7px; border-bottom: 1px solid #eee; background: #fff; }
    .sp-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .spread-card img { display: block; width: 100%; aspect-ratio: 1.5; object-fit: cover; }
    /* the opening (see the script below): the cards wait while a line winds into a spiral and flies to the logo, then fly out of the logo into the fan */
    #hero .spread.pre .spread-card { opacity: 0; }
    #hero .spread.fly .spread-card { animation: sp-fly 1s cubic-bezier(.2, .9, .25, 1.06) calc(var(--i) * .11s) backwards; }
    @keyframes sp-fly {
        0% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(540deg) scale(.08); }
        16% { opacity: 1; }
        100% { opacity: 1; transform: rotate(var(--r)); }
    }
    #introSvg { position: fixed; inset: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 2000; overflow: visible; }
    #introSvg path { vector-effect: non-scaling-stroke; }
    @media (prefers-reduced-motion: reduce) { #hero .spread.pre .spread-card { opacity: 1; } #hero .spread.fly .spread-card { animation: none; } }
    @container (max-width: 235px) { .new-word { display: none; } }
    /* the card's picture: a real screenshot of the category's best design, in a small window (a category with no picture keeps the drawn wireframe) */
    #contentGrid .card-image:not(.no-thumb) { padding: 12px 24px 0; }
    #contentGrid .card-image:not(.no-thumb) .thumb-fallback, #contentGrid .card-image.no-thumb .thumb-win { display: none; }
    .thumb-win { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #fff; border-radius: 8px 8px 0 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .18); }
    .thumb-bar { flex: none; display: flex; align-items: center; gap: 3px; height: 12px; padding-left: 6px; border-bottom: 1px solid #eee; }
    .thumb-bar i { width: 4px; height: 4px; border-radius: 9999px; background: #d1d5db; }
    .thumb-img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: center; }
</style>
<div id="contentGrid" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 p-6">

            {{#each categories}}
            <a href="/category/{{this.slug}}" data-kind="{{this.kind}}" class="component-card group block">
                <div
                    class="bg-gray-50 h-[225px] overflow-hidden border border-gray-400 rounded-xl group-hover:border-2 group-hover:border-gray-400 group-hover:shadow-xl">
                    <div
                        class="card-image h-[70%] bg-gray-100 px-10 pt-5 shadow-2xl shadow-white border border-gray-100">
                        <div class="thumb-win"><div class="thumb-bar"><i></i><i></i><i></i></div><img class="thumb-img" src="/public/images/categories/{{this.slug}}.jpg" alt="" loading="lazy" onerror="this.closest('.card-image').classList.add('no-thumb')"></div>
                        <div class="thumb-fallback">{{> category-thumbnail slug=this.slug}}</div>
                    </div>
                    <div class="flex items-center h-[30%] justify-between bg-white p-4">
                        <div class="min-w-0 flex-1">
                            <h4 class="mb-1 truncate font-semibold text-primary text-sm group-hover:text-primary transition" title="{{this.name}}">{{this.name}}</h4>
                            <p class="flex items-center gap-2 whitespace-nowrap text-sm text-gray-500">{{this.count}} components
                                {{#if this.hasNew}}<span class="shrink-0 rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-primary">+{{this.newCount}}<span class="new-word"> NEW</span></span>{{/if}}
                            </p>
                        </div>
                    </div>
                </div>
            </a>
            {{/each}}

        </div>
    </div>

    <script>
        document.getElementById("skeletonGrid").classList.add("hidden");
        document.getElementById("contentGrid").classList.remove("hidden");
        (function () {
            var tabs = document.getElementById("kindTabs");
            if (!tabs) return;
            var show = function (kind) {
                [].forEach.call(tabs.querySelectorAll(".kind-tab"), function (t) { t.setAttribute("aria-selected", String(t.dataset.kind === kind)); });
                [].forEach.call(document.querySelectorAll(".component-card[data-kind]"), function (c) { c.classList.toggle("kind-hidden", Boolean(kind) && c.dataset.kind !== kind); });
                try { sessionStorage.setItem("wc:galleryKind", kind); } catch (e) {}
            };
            tabs.addEventListener("click", function (e) { var b = e.target.closest(".kind-tab"); if (b) show(b.dataset.kind); });
            var saved = ""; try { saved = sessionStorage.getItem("wc:galleryKind") || ""; } catch (e) {}
            if (saved) show(saved);
        })();
    </script>
</main>



{{!-- Modals --}}

{{> component-playground/index}}

<script>
    // The hero's opening, once per visit (the page head decides: it hides the logo with html.intro). A line comes in from the right edge and winds into a spiral lying on its side, with dust
    // blowing off it; then the line flows on, along its own path, up to the logo in the top left corner and into it (the real logo fades in), and the designs fly out of the logo into the fan.
    (function () {
        var root = document.documentElement, sp = document.querySelector("#hero .spread"), brand = document.querySelector("[data-brand]");
        var done = function () { root.classList.remove("intro"); if (sp) sp.classList.remove("pre"); };
        if (!root.classList.contains("intro")) return;
        try { sessionStorage.setItem("wc:hero-played", "1"); } catch (e) { /* ignore */ }
        if (!sp || !brand || getComputedStyle(sp).display === "none" || !sp.animate) return done();
        sp.classList.add("pre");

        var NS = "http://www.w3.org/2000/svg", mk = function (n, a) { var e = document.createElementNS(NS, n); for (var k in a) e.setAttribute(k, a[k]); return e; };
        var bez = function (P, t) { var u = 1 - t; return [u * u * u * P[0][0] + 3 * u * u * t * P[1][0] + 3 * u * t * t * P[2][0] + t * t * t * P[3][0], u * u * u * P[0][1] + 3 * u * u * t * P[1][1] + 3 * u * t * t * P[2][1] + t * t * t * P[3][1]]; };
        var R = sp.getBoundingClientRect(), B = brand.getBoundingClientRect(), W = window.innerWidth;
        var cy = R.top + R.height * 0.52, hx = R.left + R.width * 0.74, L = R.width * 0.3, tx = B.left + 17, ty = B.top + B.height / 2;
        var i, t, pts = [];
        // 1) in from the right edge, down to the wide end of the spiral
        var A = [[W + 70, cy - 120], [W - 120, cy - 150], [hx + 190, cy - 40], [hx + 22, cy]];
        for (i = 0; i <= 40; i++) pts.push(bez(A, i / 40));
        var enterEnd = pts.length - 1;
        // 2) the spiral: it lies on its side, wide at the right and narrowing to its tip on the left; each loop is a flat ellipse
        var loops = 7, n = 420, a, r, tilt = -0.2, ct = Math.cos(tilt), st = Math.sin(tilt);
        for (i = 1; i <= n; i++) { t = i / n; a = t * loops * 2 * Math.PI; r = 7 + 56 * Math.pow(1 - t, 0.85); var ex = r * 0.52 * Math.cos(a), ey = r * Math.sin(a); pts.push([hx - t * L + ex * ct - ey * st, cy + ex * st + ey * ct]); }
        var tipEnd = pts.length - 1, tip = pts[tipEnd];
        // 3) on from the tip, in a curve up to the logo
        var C = [tip, [tip[0] - 70, tip[1] - 110], [tx + 150, ty + 120], [tx, ty]];
        for (i = 1; i <= 70; i++) pts.push(bez(C, i / 70));

        var d = ""; for (i = 0; i < pts.length; i++) d += (i ? "L" : "M") + pts[i][0].toFixed(1) + " " + pts[i][1].toFixed(1);
        var svg = mk("svg", { id: "introSvg", "aria-hidden": "true" }), defs = mk("defs", {}), blur = mk("filter", { id: "introSmoke", x: "-50%", y: "-50%", width: "200%", height: "200%" }), dust = mk("g", { filter: "url(#introSmoke)" }), path = mk("path", { d: d, pathLength: "1", fill: "none", stroke: "#2b2b2b", "stroke-width": "2.6", "stroke-linecap": "round", "stroke-linejoin": "round" });
        path.style.strokeDasharray = "0 3";
        blur.appendChild(mk("feGaussianBlur", { stdDeviation: "5" })); defs.appendChild(blur); svg.appendChild(defs);
        svg.appendChild(dust); svg.appendChild(path); document.body.appendChild(svg);
        var total = path.getTotalLength(), frac = function (idx) { var len = 0; for (var j = 1; j <= idx; j++) len += Math.hypot(pts[j][0] - pts[j - 1][0], pts[j][1] - pts[j - 1][1]); return len / total; };
        var hSpiral = frac(tipEnd);

        // the line: it is drawn up to the tip of the spiral, rests there a moment, then flows on to the logo, its tail catching up until it has all gone into the logo
        var T1 = 1500, HOLD = 380, T2 = 1150, D = T1 + HOLD + T2, kf = [], ease = function (x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
        var easeDraw = function (x) { return 1 - Math.pow(1 - x, 2.2); };
        kf.push({ offset: 0, strokeDasharray: "0 3", strokeDashoffset: "0" });
        for (i = 1; i <= 6; i++) { var q = i / 6, h = hSpiral * easeDraw(q); kf.push({ offset: (T1 * q) / D, strokeDasharray: h + " 3", strokeDashoffset: "0" }); }
        kf.push({ offset: (T1 + HOLD) / D, strokeDasharray: hSpiral + " 3", strokeDashoffset: "0" });
        for (i = 1; i <= 12; i++) { var s = ease(i / 12), hh = hSpiral + (1 - hSpiral) * s, tau = Math.pow(s, 1.5); kf.push({ offset: (T1 + HOLD + T2 * (i / 12)) / D, strokeDasharray: Math.max(hh - tau, 0) + " 3", strokeDashoffset: String(-tau) }); }
        path.animate(kf, { duration: D, easing: "linear", fill: "forwards" });

        // the smoke: soft grey puffs that come off the line as it is drawn, swell, and drift away up and to the right
        var puff = function (p, delay) {
            var pt = path.getPointAtLength(p * total), r0 = 4 + Math.random() * 9, c = mk("circle", { cx: pt.x + (Math.random() - 0.5) * 22, cy: pt.y + (Math.random() - 0.5) * 22, r: r0.toFixed(1), fill: Math.random() < 0.5 ? "#9ca3af" : "#cbd5e1" });
            dust.appendChild(c);
            c.style.transformBox = "fill-box"; c.style.transformOrigin = "center";
            c.animate([{ opacity: 0, transform: "translate(0,0) scale(.6)" }, { opacity: 0.38, offset: 0.25 }, { opacity: 0, transform: "translate(" + (30 + Math.random() * 110) + "px," + (-8 - Math.random() * 58) + "px) scale(" + (2 + Math.random() * 1.6) + ")" }], { duration: 1300 + Math.random() * 1200, delay: delay, easing: "ease-out", fill: "backwards" });
        };
        for (i = 0; i < 70; i++) { var pp = frac(enterEnd) + Math.random() * (hSpiral - frac(enterEnd)); puff(pp, T1 * easeInv(pp / hSpiral) - 80); }
        for (i = 0; i < 34; i++) { var p2 = hSpiral + Math.random() * (1 - hSpiral); puff(p2, T1 + HOLD + T2 * Math.min(1, (p2 - hSpiral) / (1 - hSpiral)) * 0.9 - 60); }
        function easeInv(y) { return 1 - Math.pow(1 - Math.min(Math.max(y, 0), 1), 1 / 2.2); }

        // the arrival: the real logo fades in as the line goes into it, and the designs come out of the logo
        setTimeout(function () {
            root.classList.remove("intro");
            svg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 420, delay: 120, fill: "forwards" }).onfinish = function () { svg.remove(); };
            sp.querySelectorAll(".spread-card").forEach(function (c) { var r = c.getBoundingClientRect(); c.style.setProperty("--dx", (tx - (r.left + r.width / 2)) + "px"); c.style.setProperty("--dy", (ty - (r.top + r.height / 2)) + "px"); });
            sp.classList.remove("pre"); sp.classList.add("fly");
        }, D - 120);
    })();
</script>
