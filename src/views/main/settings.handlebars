<main class="min-w-0 flex-1 p-6">
    <div class="mx-auto max-w-3xl space-y-6 pb-24">
        <header>
            <h1 class="text-4xl font-bold text-gray-900">Settings</h1>
            <p class="mt-2 text-gray-600">Your account, the AI features, and your access token.</p>
        </header>

        <nav class="flex gap-2 text-sm" aria-label="Sections">
            <a href="#account" class="rounded-full border border-gray-300 bg-white px-3 py-1 text-gray-700 hover:bg-gray-50">Account</a>
            <a href="#password" class="rounded-full border border-gray-300 bg-white px-3 py-1 text-gray-700 hover:bg-gray-50">Password</a>
            <a href="#ai" class="rounded-full border border-gray-300 bg-white px-3 py-1 text-gray-700 hover:bg-gray-50">AI</a>
            <a href="#token" class="rounded-full border border-gray-300 bg-white px-3 py-1 text-gray-700 hover:bg-gray-50">Access token</a>
            <a href="#danger" class="rounded-full border border-red-200 bg-white px-3 py-1 text-red-600 hover:bg-red-50">Delete account</a>
        </nav>

        <!-- Account -->
        <section id="account" class="scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-gray-900">Account</h2>
            <form id="nameForm" class="mt-4 space-y-4">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-gray-700" for="nameInput">Name</label>
                    <input id="nameInput" type="text" maxlength="80" required class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-gray-700">Email</label>
                    <input id="emailShown" type="email" disabled class="w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-500">
                </div>
                <p class="text-sm text-gray-600">Sign-in: <span id="methods" class="font-medium text-gray-900">…</span> · Member since <span id="since" class="font-medium text-gray-900">…</span></p>
                <button type="submit" class="rounded-xl bg-black px-4 py-2 text-sm font-medium text-white hover:opacity-90">Save name</button>
            </form>
        </section>

        <!-- Password -->
        <section id="password" class="scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-6">
            <h2 id="pwTitle" class="text-lg font-semibold text-gray-900">Password</h2>
            <p id="pwNote" class="mt-1 text-sm text-gray-600"></p>
            <form id="pwForm" class="mt-4 space-y-4">
                <div id="currentWrap">
                    <label class="mb-1.5 block text-sm font-medium text-gray-700" for="curPw">Current password</label>
                    <input id="curPw" type="password" autocomplete="current-password" class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-gray-700" for="newPw">New password</label>
                    <input id="newPw" type="password" minlength="6" autocomplete="new-password" required placeholder="At least 6 characters" class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                </div>
                <button id="pwBtn" type="submit" class="rounded-xl bg-black px-4 py-2 text-sm font-medium text-white hover:opacity-90">Change password</button>
            </form>
        </section>

        <!-- AI -->
        <section id="ai" class="scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-6">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">AI generation</h2>
                    <p class="mt-1 text-sm text-gray-600">Shows the AI prompt in the editor. Uses your own Anthropic key or a local model.</p>
                </div>
                <button id="llmToggle" type="button" role="switch" aria-checked="false" aria-label="Enable AI generation"
                    class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 transition-colors duration-200 focus:outline-none">
                    <span id="llmKnob" class="pointer-events-none inline-block h-5 w-5 translate-x-0 rounded-full bg-white shadow transition duration-200"></span>
                </button>
            </div>
            <div id="aiBody" class="mt-5 space-y-4 opacity-40 pointer-events-none">
                <div class="grid grid-cols-2 gap-3">
                    <button id="provAnthropic" type="button" class="rounded-xl border-2 px-4 py-3 text-left"><span class="block text-sm font-medium text-gray-900">Anthropic</span><span class="block text-xs text-gray-500">Claude API</span></button>
                    <button id="provLocal" type="button" class="rounded-xl border-2 px-4 py-3 text-left"><span class="block text-sm font-medium text-gray-900">Local LLM</span><span class="block text-xs text-gray-500">Self-hosted</span></button>
                </div>
                <div id="anthropicBox" class="space-y-2">
                    <label class="block text-sm font-medium text-gray-700" for="keyInput">Anthropic API key</label>
                    <input id="keyInput" type="password" placeholder="sk-ant-..." autocomplete="off" class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                    <p id="keyStatus" class="text-xs text-gray-500"></p>
                </div>
                <div id="localBox" class="hidden space-y-2">
                    <label class="block text-sm font-medium text-gray-700" for="urlInput">Local LLM URL</label>
                    <input id="urlInput" type="url" placeholder="http://localhost:5001" class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900">
                    <p class="text-xs text-gray-500">Must expose an OpenAI-compatible /v1/chat/completions endpoint.</p>
                </div>
            </div>
            <button id="aiSave" type="button" class="mt-5 rounded-xl bg-black px-4 py-2 text-sm font-medium text-white hover:opacity-90">Save AI settings</button>
        </section>

        <!-- Access token -->
        <section id="token" class="scroll-mt-24 rounded-2xl border border-gray-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-gray-900">Access token</h2>
            <p class="mt-1 text-sm text-gray-600">Lets tools like Claude Code and Cursor reach your projects through the MCP server. Setup steps are on <a class="underline" href="/connect">Connect</a>.</p>
            <p id="tokenState" class="mt-4 text-sm text-gray-700"></p>
            <div id="tokenBox" class="mt-3 hidden rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
                Copy it now, it is shown only once:
                <code id="tokenValue" class="mt-1 block break-all font-mono text-[13px]"></code>
            </div>
            <div class="mt-4 flex gap-2">
                <button id="tokenGen" type="button" class="rounded-xl bg-black px-4 py-2 text-sm font-medium text-white hover:opacity-90">Generate</button>
                <button id="tokenRevoke" type="button" class="hidden rounded-xl border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Revoke</button>
            </div>
        </section>

        <!-- Delete -->
        <section id="danger" class="scroll-mt-24 rounded-2xl border border-red-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-red-700">Delete account</h2>
            <p class="mt-1 text-sm text-gray-600">Permanently deletes your account, your projects and designs (including any you made public), and your tokens. This can't be undone.</p>
            <form id="delForm" class="mt-4 space-y-3">
                <input id="delEmail" type="email" required autocomplete="off" placeholder="Type your email to confirm" class="w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600">
                <input id="delPw" type="password" autocomplete="current-password" placeholder="Your password" class="hidden w-full rounded-xl border border-gray-300 px-3.5 py-2.5 text-sm focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600">
                <button id="delBtn" type="submit" class="rounded-xl bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Delete my account</button>
            </form>
        </section>
    </div>
</main>
<script src="/public/js/settings-page.js"></script>
